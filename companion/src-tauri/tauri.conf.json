{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HIDShift Companion",
  "version": "0.1.0",
  "identifier": "dev.hidshift.companion",
  "build": {
    "beforeDevCommand": "mise run web:serve",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "mise run web:build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "HIDShift Companion", "width": 1100, "height": 760 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": false
  }
}
